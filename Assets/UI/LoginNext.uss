#Next {
    position: absolute;
    right: 30px;
    bottom: 30px;
    
    width: 120px;
    height: 120px;
    border-radius: 50%;
    
    /* 使用 MD3 的 primary container 或自定义品牌色 */
    background-color: #004e0eff; 
    
    border-width: 0;
    
    justify-content: center;
    align-items: center;
    
    color: #FFFFFF; /* on-primary-container 角色 */
    font-size: 48px; /* 向 Label Large 靠拢，可按需调整 */
    -unity-font-style: normal; /* 去掉 bold，或改用 medium 字重 */
    -unity-font: url("project://database/Assets/Models/LXGWWenKaiMono-Medium.ttf");
    
    transition-property: scale, opacity,border-radius; /* 聚焦于 MD3 允许的反馈维度 */
    transition-duration: 0.25s;
    transition-timing-function: ease-out-back;
    scale: 1;
}


/* 可选：用 scale 表达轻微的按下反馈，而非改形状 */
#Next:active {
    scale: 0.96;
    border-radius: 15%;
}